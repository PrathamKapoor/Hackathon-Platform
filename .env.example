# Verdict configuration.
#
# Copy to `.env` and edit. Every value here has a working default except
# SESSION_SECRET, which has none on purpose.
#
#   cp .env.example .env
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ---------------------------------------------------------------- required

# Signs session cookies. Must be at least 32 characters. Rotating it signs
# everyone out, so set it once and keep it — an organizer mid-event will not
# thank you for a deploy that logs out the judging panel.
#
# In production a missing or short value is a fatal boot error rather than a
# warning, because the alternative is a per-boot random secret that logs
# everyone out on every deploy.
SESSION_SECRET=

# The public origin of this instance. Used for links in emails and webhooks,
# and to decide whether secure cookies are meaningful.
PUBLIC_URL=http://localhost:8080

# ----------------------------------------------------------------- server

HOST=0.0.0.0
PORT=8080
NODE_ENV=production

# debug | info | warn | error | silent
LOG_LEVEL=info
# Human-readable single-line logs. Turn on for a laptop, off for a server.
LOG_PRETTY=false

# Set to true ONLY when running behind a reverse proxy you control, because it
# makes the app believe X-Forwarded-For. With it on and no proxy in front, a
# client can spoof its own IP and walk straight through a per-IP rate limit.
TRUST_PROXY=false

# ------------------------------------------------------------------ data

DATABASE_FILE=/data/verdict.db
STORAGE_DIR=/data/uploads
WEB_DIST_DIR=/app/apps/web/dist

# Apply pending migrations on boot. Safe to leave on; migrations are
# transactional and refuse to run if an already-applied one has been edited.
AUTO_MIGRATE=true

# Seed the demo dataset when the database has no users. Convenient for a first
# run and a screenshot; set to false for a real event.
AUTO_SEED=true

# ---------------------------------------------------------------- session

SESSION_COOKIE_NAME=verdict_session
CSRF_COOKIE_NAME=verdict_csrf
CSRF_HEADER_NAME=x-verdict-csrf

SESSION_IDLE_TIMEOUT_DAYS=14
SESSION_ABSOLUTE_TIMEOUT_DAYS=90

# Leave false for plain http on localhost. Set to true the moment you serve the
# instance over https — a session cookie sent in clear text is readable by
# anything on the path.
SESSION_SECURE_COOKIES=false

# ----------------------------------------------------------------- limits

RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# Per-account, per-window. Ten sign-in attempts every five minutes is enough for
# a person who forgets their password twice.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=300000

VOTE_RATE_LIMIT_MAX=60
VOTE_RATE_LIMIT_WINDOW_MS=3600000

MAX_JSON_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=8388608
WEBHOOK_TIMEOUT_MS=5000

# Keep this false. It exists so a developer can point a webhook at a service on
# their own machine, and turning it on in production hands anyone who can create
# a webhook a way to reach services inside your network.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# ---------------------------------------------------------------- judging

REVIEWS_PER_PROJECT=3
MINIMUM_JUDGES=3

# The seed every assignment is generated from. Changing it produces a
# different — but equally reproducible — assignment for the same inputs.
ASSIGNMENT_SEED=verdict-default-assignment-seed
